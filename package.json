{
  "name": "faceless-forge",
  "type": "module",
  "scripts": {
    "dev": "npx vercel dev",
    "build": "esbuild server/vercel-entry.ts --bundle --platform=node --format=cjs --target=node20 --outfile=server/function-bundle.cjs",
    "typecheck": "tsc --noEmit",
    "deploy": "npx vercel --prod"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "@vercel/blob": "^2.0.0",
    "hono": "^4.13.5"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "^5.9.3"
  }
}
