{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/page?__hono_path=/"
    },
    {
      "source": "/studio",
      "destination": "/api/page?__hono_path=/studio"
    }
  ]
}
